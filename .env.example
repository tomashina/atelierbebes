APP_NAME=Libermedia
APP_ENV=local
APP_KEY=
APP_DEBUG=true

STOCK_NOTIFICATIONS_ENABLED=true
# Delivery defaults to production only; requires a real configured mail transport.
# Run Laravel's scheduler every minute to check availability every five minutes.
# STOCK_NOTIFICATIONS_EMAILS_ENABLED=false
STOCK_NOTIFICATIONS_BATCH_SIZE=50
GIFT_VOUCHERS_ENABLED=true
# Gift voucher emails default to production only and require a real mail transport.
# GIFT_VOUCHER_EMAILS_ENABLED=false
APP_URL=http://libermedia-new.test
APP_LOCALE=hr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

LIBERMEDIA_SOURCE_HOSTNAME=127.0.0.1
LIBERMEDIA_SOURCE_PORT=3306
LIBERMEDIA_SOURCE_DATABASE=libermedia
LIBERMEDIA_SOURCE_USERNAME=root
LIBERMEDIA_SOURCE_PASSWORD=

# Keep the Herrera presentation independently of Liber Media branding.
STOREFRONT_THEME=herrera
STOREFRONT_HOME=libermedia

STOREFRONT_BRAND=libermedia

STORE_B2C_ONLY=true
STORE_B2B_ONLY=false
STORE_B2B_DISPLAY_NET=false
